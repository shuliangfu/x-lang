          return rc;
        }
        if (src_kind == 14) {
          unsafe {
            rc = pipeline_asm_emit_expr_elf_c(arena, elf_ctx, op, ctx, ta);
          }
          if (rc != 0) {
            return 0 - 1;
          }
          unsafe {
            rc = backend_enc_cvtss2sd_rax_from_f32_bits_arch(elf_ctx, ta);
          }
          return rc;
        }
      }
    }
  }
  unsafe {
    rc = pipeline_asm_emit_expr_elf_c(arena, elf_ctx, op, ctx, ta);
  }
  return rc;
}

