#[no_mangle]
export function pipeline_expr_enum_namespace_field_tag(a: *u8, expr_ref: i32): i32 {
  let base_buf: u8[32] = [];
  let field_buf: u8[128] = [];
  let blen: i32 = 0;
  let flen: i32 = 0;
  let base_ref: i32 = 0;
  let ko: i32 = 0;
  let tk: i32 = 0;
  let mod_tag: i32 = 0;
