        slot_off = off + width;
      } else {
        slot_off = off;
      }
      unsafe {
        ap = asm_ctx_local_append(ctx, &pname_buf[0], plen, slot_off);
      }
      if (ap < 0) {
        return;
      }
      unsafe {
        nloc = asm_ctx_local_count(ctx);
      }
      pipe_store_i32_le(ctx, pipe_asm_ctx_off_num_locals(), nloc);
      if (width > 8) {
