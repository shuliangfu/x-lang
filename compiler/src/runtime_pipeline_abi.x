    if (lo < 0 || lo > 3) {
      return 0 - 1;
    }
    if (i == 0) {
      m0 = lo;
    } else {
      if (i == 1) {
        m1 = lo;
      } else {
        if (i == 2) {
          m2 = lo;
        } else {
          m3 = lo;
        }
      }
    }
    i = i + 1;
  }
  if (lanes == 8) {
    i = 0;
    while (i < 4) {
