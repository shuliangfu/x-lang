 */
function pipe_pctx_off_num_lib_roots(): i32 {
  return 520;
}

/**
 * LP64 offsetof(ast_PipelineDepCtx, loaded_len) - ptrdiff_t / i64 cell.
 * PLATFORM: SHARED LP64.
