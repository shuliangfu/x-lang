  let i: i32 = 0;
  while (i < pipe_dep_sc_max()) {
    let sc: *u8 = pipe_dep_sc_at(i);
    let used: i32 = pipe_load_i32_le(sc, pipe_dep_sc_off_used());
    if (used != 0) {
      let k: *u8 = pipe_load_ptr_slot(sc, 0);
      if (k == ctx) {
        pipe_dep_sc_free(sc);
        return;
      }
    }
    i = i + 1;
  }
}


/**
