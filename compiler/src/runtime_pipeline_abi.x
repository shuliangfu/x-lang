  if (path_len > 0) {
    unsafe {
      ast_pipeline_dep_ctx_set_import_path(ctx, import_idx, &path_buf[0], path_len);
    }
  }
  unsafe {
    pipeline_bind_import_dep_buffers(ctx, import_idx);
  }
