  panic_nm[3] = 110 as u8;  // n
  panic_nm[4] = 103 as u8;  // g
  panic_nm[5] = 95 as u8;   // _
  panic_nm[6] = 112 as u8;  // p
  panic_nm[7] = 97 as u8;   // a
  panic_nm[8] = 110 as u8;  // n
  panic_nm[9] = 105 as u8;  // i
  panic_nm[10] = 99 as u8;  // c
  panic_nm[11] = 95 as u8;  // _
