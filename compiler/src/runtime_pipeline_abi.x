#[no_mangle]
export function pipeline_asm_set_call_expected_ret_ty_c(type_ref: i32): void {
  if (type_ref > 0) {
    g_call_expected_ret_ty = type_ref;
  } else {
    g_call_expected_ret_ty = 0;
  }
}

/**
 * Get the current CALL's expected return type ref.
