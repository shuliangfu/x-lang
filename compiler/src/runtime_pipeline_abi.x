  unsafe {
    rr = pipeline_read_file_x(ctx);
  }
  if (rr != 0) {
    return 0 - 8;
  }
  unsafe {
    rr = pipeline_preprocess_loaded_into_ctx(ctx);
  }
  if (rr != 0) {
    return 0 - 9;
