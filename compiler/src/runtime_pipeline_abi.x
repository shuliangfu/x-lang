            return -1;
          }
          unsafe {
            rc = backend_enc_load_x29_pos_to_rax_arch(elf_ctx, stack_pos + 8, ta);
          }
          if (rc != 0) {
            return -1;
          }
          unsafe {
            rc = backend_enc_store_rax_to_rbp_arch(elf_ctx, home + 8, ta);
