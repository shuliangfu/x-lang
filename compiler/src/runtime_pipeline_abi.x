  let off: i32 = pipe_en_entry_off(n);
  let esz: i32 = pipe_en_entry_size();
  unsafe {
    memset(base + off, 0, esz as usize);
  }
  g_pipe_en_n[s] = n + 1;
  pipe_en_set_header_n(module, n + 1);
  return n;
}

/**
