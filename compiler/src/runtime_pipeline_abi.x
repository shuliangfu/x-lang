  unsafe {
    ko = pipeline_expr_kind_ord_at(arena, base_ref);
  }
  if (ko == 3) {
    return w156_index_expr_struct_key(arena, base_ref);
  }
  return w156_index_addr_key_mix64(1, base_ref as i64);
