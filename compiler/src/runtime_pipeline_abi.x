      if (rc != 0) {
        return 0 - 1;
      }
      return 0;
    }
  }

  unsafe {
    slice_st = glue_emit_slice_from_array_let_init_elf_c(arena, elf_ctx, block_ref, idx, init_ref, pipeline_block_let_type_ref(arena, block_ref, idx), ctx, ta, slot_off);
  }
  if (slice_st == 1) {
