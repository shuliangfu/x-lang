/**
 * Callee is Vec4f FMA3 intrinsic name.
 * wave148 pure helper. PLATFORM: SHARED.
 */
#[no_mangle]
export function glue_callee_is_vec4f_fma3_c(cname: *u8, clen: i32): i32 {
