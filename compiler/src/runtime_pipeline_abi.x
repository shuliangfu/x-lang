      pi = pi + 1;
    }
    let digs: u8[8] = [];
    let nd: i32 = 0;
    let v: i32 = idx;
    if (v == 0) {
      digs[0] = 48 as u8;
      nd = 1;
    } else {
      while (v > 0 && nd < 8) {
        let dig: i32 = v % 10;
        digs[nd] = (48 + dig) as u8;
        nd = nd + 1;
        v = v / 10;
      }
    }
    let di: i32 = nd - 1;
    while (di >= 0 && llen < 23) {
      unsafe {
        g_pipeline_asm_modlet[lbase + llen] = digs[di];
