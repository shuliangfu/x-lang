  let dep_sync_i: i32 = 0;
  while (dep_sync_i < dep_sync_nd) {
    let sync_rc: i32 = 0;
    unsafe {
      sync_rc = pipeline_sync_one_dep_slot(module, ctx, dep_sync_i);
    }
    if (sync_rc != 0) {
      return sync_rc;
    }
    dep_sync_i = dep_sync_i + 1;
  }
  return 0;
}

