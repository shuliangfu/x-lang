  lea7[1] = 0x8d as u8;
  lea7[2] = 0x1d as u8;
  lea7[3] = 0 as u8;
  lea7[4] = 0 as u8;
  lea7[5] = 0 as u8;
  lea7[6] = 0 as u8;
