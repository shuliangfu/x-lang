let g_pipe_entry_lib_kw6: u8[7] = [112, 97, 114, 115, 101, 114, 0];
let g_pipe_entry_lib_kw7: u8[6] = [116, 111, 107, 101, 110, 0];
let g_pipe_entry_lib_kw8: u8[6] = [108, 101, 120, 101, 114, 0];
let g_pipe_entry_lib_kw9: u8[4] = [97, 115, 116, 0];
