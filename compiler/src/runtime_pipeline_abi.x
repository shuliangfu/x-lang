  unsafe {
    asm_ctx_fill_locals_block_tree(&ctx_buf[0], arena, block_ref, &next_off, &num_loc);
    arr_temp = asm_sum_block_array_temp_bytes(arena, block_ref);
    call_spill = glue_asm_sum_block_call_spill_bytes(arena, block_ref);
