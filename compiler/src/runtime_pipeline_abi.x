    lit_ok = pipeline_asm_cmp_expr_lit_i32_at(arena, right_ref, &lit_slot[0]);
    lit_imm = lit_slot[0];
    if (ko == 3 && is_f64 == 0 && is_f32 == 0 && lit_ok != 0) {
      unsafe {
