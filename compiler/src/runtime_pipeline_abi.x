            unsafe { rc = backend_enc_lea_rbp_to_rax_arch(elf_ctx, home, ta); }
            if (rc != 0) { return 0 - 1; }
            return 0;
          }
          if (glue_call_arg_var_use_lea_not_load_elf_c(arena, expr_ref, ctx) != 0) {
