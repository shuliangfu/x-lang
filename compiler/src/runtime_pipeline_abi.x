  let tr: i32 = 0;
  let esz: i32 = 0;
  let rc: i32 = 0;
  unsafe {
    op = pipeline_expr_unary_operand_ref_at(arena, expr_ref);
  }
  if (op <= 0) {
    return 0 - 1;
  }
  unsafe {
    rc = pipeline_asm_emit_expr_elf_c(arena, elf_ctx, op, ctx, ta);
  }
  if (rc != 0) {
