    }
  }

  // --- FIELD_ACCESS fixed TYPE_ARRAY as TYPE_SLICE formal (wave396/649) ---
  if (arena != (0 as *u8) && ctx != (0 as *u8) && elf_ctx != (0 as *u8)) {
    unsafe { ko = pipeline_expr_kind_ord_at(arena, expr_ref); }
    if (ko == kind_field) {
