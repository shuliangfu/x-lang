#[no_mangle]
export function glue_binop_kill_assign_lhs_slots_elf_c(arena: *u8, ctx: *u8, assign_expr_ref: i32): void {
  let left_ref: i32 = 0;
  let off: i32 = 0;
  let ko: i32 = 0;
