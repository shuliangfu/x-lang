/**
 * Write field align(N).
 * @param module *u8 - module
 * @param li i32 - layout index
 * @param j i32 - field index
 * @param al i32 - align (>=0)
 * @return void
 */
#[no_mangle]
export function pipeline_module_struct_layout_set_field_align(module: *u8, li: i32, j: i32, al: i32): void {
  if (j < 0) {
    return;
  }
  if (al < 0) {
