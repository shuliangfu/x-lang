    pfx[0] = 76 as u8;
    pfx[1] = 120 as u8;
    pfx[2] = 108 as u8;
    pfx[3] = 97 as u8;
    pfx[4] = 110 as u8;
    pfx[5] = 103 as u8;
    pfx[6] = 95 as u8;
    pfx[7] = 109 as u8;
    pfx[8] = 108 as u8;
    pfx[9] = 95 as u8;
    let pi: i32 = 0;
