  }
  if (name == 0 as *u8) {
    return 0;
  }
  let nlen: i32 = pipe_load_i32_le(e, pipe_en_off_name_len());
  if (nlen != name_len) {
    return 0;
  }
  let j: i32 = 0;
  while (j < name_len) {
    let b: u8 = 0 as u8;
    unsafe {
      b = e[j];
    }
    if (b != name[j]) {
      return 0;
    }
    j = j + 1;
  }
  return 1;
}

/**
 * Find variant tag in one ModuleEnumEntry by variant name.
 * @param e *u8 - entry
 * @param variant_name *u8 - variant bytes
 * @param variant_len i32 - length
 * @return i32 - tag or -1
