    unsafe {
      is_wild = pipeline_expr_match_arm_is_wildcard(arena, expr_ref, i);
      guard_ref = pipeline_expr_match_arm_guard_ref(arena, expr_ref, i);
      result_ref = pipeline_expr_match_arm_result_ref(arena, expr_ref, i);
    }
