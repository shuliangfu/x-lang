            }
            if (off >= 0) {
              unsafe {
                glue_live_fwd_add_u8(&live[0], off);
              }
            }
            j = j + 1;
          }
        }
        unsafe {
          glue_live_fwd_clear_u8(&merged[0]);
        }
        w168_live_union_into(&merged[0], &snap[0]);
        if (body_ref > 0) {
          unsafe {
            glue_asm73_interf_push();
          }
          glue_block_simulate_cfg_live(arena, ctx, body_ref, &snap[0], &sub_end[0], depth + 1);
          unsafe {
