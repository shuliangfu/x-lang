  let n: i32 = g_pipe_en_n[s];
  if (pipe_en_ensure_entries(s, n + 1) == 0) {
    return 0 - 1;
  }
  let base: *u8 = xlang_ptr_slot_get(&g_pipe_en_entries[0], s);
  if (base == 0 as *u8) {
    return 0 - 1;
