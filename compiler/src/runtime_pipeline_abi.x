      sib_pi = sib_pi + 1;
    }
    sib_parent[sib_last_slash] = 0;
    let sib_d: *u8 = xlang_fmt_opendir(&sib_parent[0]);
    if (sib_d == 0 as *u8) { return; }
    let sib_guard: i32 = 0;
    let sib_done: i32 = 0;
