                sib_doff2 = sib_doff2 + 1;
                path[sib_doff2] = 120;
                sib_doff2 = sib_doff2 + 1;
                path[sib_doff2] = 0;
                if (pipe_path_readable(path) != 0) {
                  sib_done = 1;
                }
