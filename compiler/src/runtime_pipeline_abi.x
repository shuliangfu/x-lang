        if (off + 1 >= cap) { break; }
        dst[off] = name[j];
        off = off + 1;
        j = j + 1;
      }
    }
    if (off + 1 < cap) { dst[off] = 47; off = off + 1; }
    if (name != 0 as *u8) {
      let k: i32 = 0;
      while (k < 4096) {
        if (name[k] == 0) { break; }
        if (off + 1 >= cap) { break; }
        dst[off] = name[k];
        off = off + 1;
        k = k + 1;
      }
