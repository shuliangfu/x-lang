  let nconst: i32 = 0;
  let nlet: i32 = 0;
  let idx: i32 = 0;
  let i: i32 = 0;
  let ly: *u8 = 0 as *u8;
  let num_locals: i32 = 0;
  let init_ref: i32 = 0;
  let slot: i32 = 0;
  let type_ref: i32 = 0;
