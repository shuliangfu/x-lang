  unsafe {
    glue_live_fwd_clear_u8(&gen[0]);
    glue_live_fwd_collect_expr_uses(arena, ctx, expr_ref, &gen[0]);
    glue_block_live_fwd_union_from_u8(&gen[0]);
  }
}

