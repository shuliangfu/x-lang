 * PLATFORM: SHARED freestanding 7.3.
 */
function w168_live_union_into(dst: *u8, src: *u8): void {
  let n: i32 = 0;
  let i: i32 = 0;
  let off: i32 = 0;
  if (dst == (0 as *u8) || src == (0 as *u8)) {
    return;
  }
  unsafe {
    n = glue_live_fwd_n_get(src);
  }
  i = 0;
  while (i < n) {
    unsafe {
      off = glue_live_fwd_off_at(src, i);
    }
    if (off >= 0) {
      unsafe {
        glue_live_fwd_add_u8(dst, off);
      }
    }
    i = i + 1;
  }
}

/**
