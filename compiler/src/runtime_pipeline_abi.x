    return 0 - 1;
  }
  unsafe {
    depth = glue_index_scratch_stack_depth_get();
  }
  if (depth < slot_depth) {
    return 0 - 1;
  }
  off_bytes = (depth - slot_depth) * 16;
  if (off_bytes == 0) {
    return glue_enc_reload_index_scratch_from_stack_arm64_elf_c(elf_ctx, ta);
  }
  if (ta != 1) {
    return 0;
  }
  if (elf_ctx == (0 as *u8)) {
    return 0 - 1;
