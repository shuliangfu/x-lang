function pipeline_asm_modlet_lea_rbx_arch(elf_ctx: *u8, idx: i32, ta: i32): i32 {
  if (ta == 1) {
    return pipeline_asm_modlet_lea_rbx_adrp_arm64(elf_ctx, idx);
  }
  if (ta == 0) {
