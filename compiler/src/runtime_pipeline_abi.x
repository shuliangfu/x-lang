#[no_mangle]
export function pipeline_expr_field_access_load_byte_sz(a: *u8, m: *u8, expr_ref: i32): i32 {
  let tr: i32 = 0;
  let base_tr: i32 = 0;
  let base_ref: i32 = 0;
  let struct_name: u8[128] = [];
  let nlen: i32 = 0;
  let flen: i32 = 0;
  let field_name: u8[128] = [];
  let k: i32 = 0;
  let j: i32 = 0;
  let ftr: i32 = 0;
  let kind_ord: i32 = 0;
  let nsl: i32 = 0;
  let nf: i32 = 0;
  let fnlen: i32 = 0;
  let feq: i32 = 0;
  let fi: i32 = 0;
