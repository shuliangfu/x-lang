    if (flen >= 9 && field_buf[0] == 84 as u8 && field_buf[1] == 89 as u8 && field_buf[2] == 80 as u8 && field_buf[3] == 69 as u8 && field_buf[4] == 95 as u8 && field_buf[5] == 85 as u8 && field_buf[6] == 83 as u8 && field_buf[7] == 73 as u8 && field_buf[8] == 90 as u8) {
