  // Re-home to this lit base for by-value return
  if (sret_direct == 0) {
    unsafe {
      if (backend_enc_lea_rbp_to_rax_arch(elf_ctx, base_off, ta) != 0) {
        return 0 - 1;
      }
      if (backend_enc_mov_rax_to_rbx_arch(elf_ctx, ta) != 0) {
