#[no_mangle]
export function pipeline_asm_emit_match_elf_c(arena: *u8, elf_ctx: *u8, expr_ref: i32, ctx: *u8, ta: i32): i32 {
  let matched_ref: i32 = 0;
  let num_arms: i32 = 0;
  let i: i32 = 0;
  let cmp_val: i32 = 0;
  let is_wild: i32 = 0;
  let guard_ref: i32 = 0;
