  let arr_temp: i32 = 0;
  let call_spill: i32 = 0;
  let scratch: i32 = 0;
  let prev_mod: *u8 = 0 as *u8;
  let wa_temp: i32 = 0;
  let reent_dc: i32 = 0;
  let is_arm: i32 = 0;
  let pi: i32 = 0;
  let w: i32 = 0;
  let ret_sz: i32 = 0;
  let hoist: i32 = 0;
