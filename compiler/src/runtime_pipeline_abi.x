 */
#[no_mangle]
export function pipeline_try_bind_seeded_import(ctx: *u8, import_idx: i32, global_slot: i32): i32 {
  if (ctx == 0 as *u8) {
    return 0;
  }
  if (import_idx < 0) {
    return 0;
