#[no_mangle]
export function pipeline_type_kind_ord_at(arena: *u8, ref: i32): i32 {
  let t: *u8 = pipe_ty_slot_at(arena, ref);
  if (t == 0 as *u8) {
    return 0 - 1;
  }
  return pipe_load_i32_le(t, 0);
}

