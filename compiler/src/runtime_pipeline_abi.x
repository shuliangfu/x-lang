    let k: i32 = 0;
    while (k < n) {
      unsafe {
        ly[w155_ly_off_break_label() + k] = ly[w155_ly_off_break_stack() + base_off + k];
      }
      k = k + 1;
    }
  }
  pipe_store_i32_le(ly, w155_ly_off_break_len(), bl);
  n = cl;
  if (n > 64) { n = 64; }
