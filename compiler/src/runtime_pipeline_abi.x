  let e_call: u8[9] = [69, 88, 80, 82, 95, 67, 65, 76, 76];
  let e_var: u8[8] = [69, 88, 80, 82, 95, 86, 65, 82];
  let e_block: u8[10] = [69, 88, 80, 82, 95, 66, 76, 79, 67, 75];
