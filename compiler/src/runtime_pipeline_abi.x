    let k2: i32 = 0;
    while (k2 < n) {
      unsafe {
        ly[w155_ly_off_continue_label() + k2] = ly[w155_ly_off_cont_stack() + base_off + k2];
      }
      k2 = k2 + 1;
    }
  }
  pipe_store_i32_le(ly, w155_ly_off_continue_len(), cl);
