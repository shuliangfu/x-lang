// =============================================================================
// wave262: ast_pool_type_alias.c pure-owned leave (TypeAliasEntry storage + faces)
// =============================================================================
// G.7 product authority for:
//   pipeline_module_type_alias_alloc / set / name_len / name_byte_at / target_ref
//   pipeline_module_num_type_aliases_at
//   pipeline_module_type_alias_storage_reset / storage_release
// Historical Cap residual grew ModuleSidecar.type_aliases GrowVec (static
// module_sidecar_get + grow_vec_*). Product pure owns multi-module malloc map
// keyed by Module* (same pattern as wave110 ImportEntry storage).
// Layout of one TypeAliasEntry (136 bytes LE, ≡ C typedef TypeAliasEntry):
//   name[128] @0 | name_len i32 @128 | target_type_ref i32 @132
// Soft-reset: ast_pool_module_reset calls storage_reset (zero live n, keep cap).
// Hard free: ast_pool_module_release calls storage_release (free tables + clear slot).
// Cold twins under seed #ifndef FROM_X (malloc map, freestanding).
// PLATFORM: SHARED LP64 product hybrid leave.
// =============================================================================

// Pointer-keyed module slots: 128 modules × 8-byte slots in u8[1024] arrays.
let g_pipe_ta_mod: u8[1024] = [];
let g_pipe_ta_n: i32[128] = [];
let g_pipe_ta_cap: i32[128] = [];
let g_pipe_ta_entries: u8[1024] = [];

/**
 * Byte size of one TypeAliasEntry (name[128] + name_len + target_type_ref).
 * @return i32 - 136
 * PLATFORM: SHARED LP64 - must match C sizeof(TypeAliasEntry).
 */
function pipe_ta_entry_size(): i32 {
  return 136;
}

/**
 * Byte offset of name_len within TypeAliasEntry.
 * @return i32 - 128
 * PLATFORM: SHARED LP64.
 */
function pipe_ta_off_name_len(): i32 {
  return 128;
}

/**
 * Byte offset of target_type_ref within TypeAliasEntry.
 * @return i32 - 132
 * PLATFORM: SHARED LP64.
 */
function pipe_ta_off_target(): i32 {
  return 132;
}

/**
 * Byte offset of entry idx within the flat entry table.
 * @param idx i32 - entry index
 * @return i32 - byte offset
 */
function pipe_ta_entry_off(idx: i32): i32 {
  return idx * pipe_ta_entry_size();
}

/**
 * Find map slot for module pointer (exact key match).
 * @param module *u8 - module key; null -> -1
 * @return i32 - slot 0..127 or -1
 */
function pipe_ta_find_slot(module: *u8): i32 {
  if (module == 0 as *u8) {
    return 0 - 1;
  }
  let i: i32 = 0;
  while (i < 128) {
    let k: *u8 = xlang_ptr_slot_get(&g_pipe_ta_mod[0], i);
    if (k == module) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

/**
 * Find or allocate a map slot for module.
 * @param module *u8 - module key; null -> -1
 * @return i32 - slot or -1 if map full
 */
function pipe_ta_find_or_create(module: *u8): i32 {
  if (module == 0 as *u8) {
    return 0 - 1;
  }
  let found: i32 = pipe_ta_find_slot(module);
  if (found >= 0) {
    return found;
  }
  let i: i32 = 0;
  while (i < 128) {
    let k: *u8 = xlang_ptr_slot_get(&g_pipe_ta_mod[0], i);
    if (k == 0 as *u8) {
      xlang_ptr_slot_set(&g_pipe_ta_mod[0], i, module);
      g_pipe_ta_n[i] = 0;
      g_pipe_ta_cap[i] = 0;
      xlang_ptr_slot_set(&g_pipe_ta_entries[0], i, 0 as *u8);
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

/**
 * Ensure entry table capacity >= need for slot (malloc grow, double).
 * @param slot i32 - map slot
 * @param need i32 - required live+push capacity
 * @return i32 - 1 ok, 0 fail
 */
function pipe_ta_ensure_entries(slot: i32, need: i32): i32 {
  if (slot < 0) {
    return 0;
  }
  if (slot >= 128) {
    return 0;
  }
  if (need <= 0) {
    return 1;
  }
  let cap: i32 = g_pipe_ta_cap[slot];
  if (cap >= need) {
    return 1;
  }
  let new_cap: i32 = cap;
  if (new_cap < 8) {
    new_cap = 8;
  }
  while (new_cap < need) {
    new_cap = new_cap * 2;
  }
  let esz: i32 = pipe_ta_entry_size();
  let nbytes: usize = (new_cap * esz) as usize;
  let np: *u8 = 0 as *u8;
  unsafe {
    np = malloc(nbytes);
  }
  if (np == 0 as *u8) {
    return 0;
  }
  let old: *u8 = xlang_ptr_slot_get(&g_pipe_ta_entries[0], slot);
  let old_n: i32 = g_pipe_ta_n[slot];
  if (old != 0 as *u8) {
    if (old_n > 0) {
