  unsafe {
    glue_live_fwd_clear_u8(gen);
    glue_live_fwd_collect_expr_uses(arena, ctx, fin, gen);
    n = glue_live_fwd_n_get(gen);
    glue_asm73_cfg_final_expr_use_n_set(n);
