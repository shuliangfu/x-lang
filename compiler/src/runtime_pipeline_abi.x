      continue;
    }
    if (off0 / 64 != off1 / 64) {
      j = j + 1;
      continue;
    }
    if (glue_field_type_atomic_sized(module, arena, ftr0) == 0 && glue_field_type_atomic_sized(module, arena, ftr1) == 0) {
      j = j + 1;
