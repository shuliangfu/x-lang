  unsafe {
    pipeline_dep_ctx_entry_dir_copy(ctx, &ed_buf[0], 512);
  }
  let off: i32 = pipeline_path_append_from_buf_512_c(ctx, 0, &ed_buf[0], ed_len);
  if (off < 509) {
