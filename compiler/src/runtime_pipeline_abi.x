  let next_lbl: u8[128] = [];
  let done_len: i32 = 0;
  let next_len: i32 = 0;
  let result_ref: i32 = 0;
  let prev_mod: *u8 = 0 as *u8;
  let prev_mref: i32 = 0;
  let prev_ty: i32 = 0;
  let rc: i32 = 0 - 1;
  let saw_terminal_wild: i32 = 0;
  let emit_mod: *u8 = 0 as *u8;
  let emit_fi: i32 = 0 - 1;
  let subj_ty: i32 = 0;
