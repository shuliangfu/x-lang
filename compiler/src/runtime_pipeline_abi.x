export function glue_index_reload_scratch_slot_elf_c(elf_ctx: *u8, ta: i32, slot_depth: i32): i32 {
  let depth: i32 = 0;
  let off_bytes: i32 = 0;
  let imm12: i32 = 0;
  let word: i32 = 0;
  let base: i32 = 0 - 113245214; // 0xf94003e2 ldr x2,[sp,#0]
