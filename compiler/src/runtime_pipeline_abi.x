      kind_ord = pipeline_type_kind_ord_at(a, tr);
    }
    if (kind_ord != 8 && kind_ord != 10 && kind_ord != 11 && kind_ord != 12) {
      return glue_field_access_load_bytes_for_type_ref(a, tr);
