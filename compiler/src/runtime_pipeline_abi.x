    }
    let rc2: i32 = 0;
    unsafe {
      rc2 = pipeline_typeck_entry_module_c(module, arena, ctx);
    }
    return rc2;
  }
  let skip_x: i32 = 0;
  unsafe {
    skip_x = pipeline_should_skip_x_typeck(ctx);
  }
  if (skip_x != 0) {
    return 0;
  }
  let rc3: i32 = 0;
