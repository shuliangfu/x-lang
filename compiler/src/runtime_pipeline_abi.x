                      arm_ok = 0;
                    } else {
                      if (guard_ref > 0) {
                        unsafe {
                          rc = pipeline_asm_emit_expr_elf_c(arena, elf_ctx, guard_ref, ctx, ta);
                        }
                        if (rc != 0) {
