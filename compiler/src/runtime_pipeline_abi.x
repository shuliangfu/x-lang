  let e: *u8 = xlang_ptr_slot_get(&g_pipe_en_entries[0], s);
  if (e != 0 as *u8) {
    unsafe {
      free(e);
    }
  }
  xlang_ptr_slot_set(&g_pipe_en_mod[0], s, 0 as *u8);
  xlang_ptr_slot_set(&g_pipe_en_entries[0], s, 0 as *u8);
  g_pipe_en_n[s] = 0;
  g_pipe_en_cap[s] = 0;
