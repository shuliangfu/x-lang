  let np: i32 = 0;
  let pi: i32 = 0;
  let rc: i32 = 0;
  // ctx required for API parity with Cap residual; emit module comes from CAP accessors.
  if (arena == (0 as *u8) || ctx == (0 as *u8) || var_expr_ref <= 0) {
    return 0;
