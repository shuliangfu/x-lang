#[no_mangle]
export function run_x_pipeline_codegen_one_dep_c(module: *u8, out_buf: *u8, ctx: *u8, dep_j: i32, skip_asm_dep_codegen: i32): i32 {
  if (module == 0 as *u8) {
    return 0 - 1;
  }
  if (out_buf == 0 as *u8) {
    return 0 - 1;
  }
  if (ctx == 0 as *u8) {
    return 0 - 1;
