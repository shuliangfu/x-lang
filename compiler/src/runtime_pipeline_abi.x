      mvn_x0[0] = 0xe0 as u8;
      mvn_x0[1] = 0x03 as u8;
      mvn_x0[2] = 0x20 as u8;
      mvn_x0[3] = 0xaa as u8;
      unsafe {
        rc = pipeline_elf_ctx_append_bytes(elf_ctx, &mvn_x0[0], 4);
      }
      return rc;
    }
  }
  unsafe {
    rc = backend_enc_not_eax_arch(elf_ctx, ta);
  }
  if (rc != 0) {
    return 0 - 1;
  }
  // TYPE_I32 = 0
  if (kind_ord == 0) {
    return glue_enc_sxt_i32_result_to_rax_elf_c(elf_ctx, ta);
  }
  return 0;
}

