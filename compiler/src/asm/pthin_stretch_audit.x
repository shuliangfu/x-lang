      kind = parser_asm_lex_peek_kind_c(lex_inout, source);
      if (kind != TOKEN_COLON) {
        parser_asm_lex_set_pos_c(lex_inout, pos0);
        parser_asm_lex_set_line_c(lex_inout, line0);
        parser_asm_lex_set_col_c(lex_inout, col0);
        return 0;
